{
  "expo": {
    "name": "StockEvo",
    "slug": "stockevo",
    "scheme": "stockevo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockevo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stockevo.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFC20E",
          "resizeMode": "contain",
          "android": {
            "drawable": {
              "icon": "./assets/android/splashscreen_logo.xml"
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "StockEvo uses your photos so you can set your own product pictures."
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "034b531f-1299-4118-a385-e1d387430124"
      }
    }
  }
}
