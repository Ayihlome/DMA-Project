{
  "expo": {
    "name": "StockEvo",
    "slug": "stockevo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockevo.app"
    },
    "android": {
      "package": "com.stockevo.app"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "StockEvo uses your photos so you can set your own product pictures."
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
