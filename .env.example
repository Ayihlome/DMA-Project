# Copy to .env and fill in from Supabase: Project Settings -> API (or the "Connect" button).
# Only EXPO_PUBLIC_* variables reach the app bundle, which is what these need to be.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase renamed the anon key to the publishable key. Set either one; the app
# prefers PUBLISHABLE_KEY and falls back to ANON_KEY.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service role key in this file or anywhere in the app: it bypasses
# Row Level Security and anyone can extract it from the shipped bundle. Account
# deletion goes through the delete_own_account() database function instead.

LOG_LEVEL=debug
